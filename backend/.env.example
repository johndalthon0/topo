# Copia este archivo como ".env" y completa los valores (no lo subas a git).
# En local (XAMPP MySQL) puedes dejar todo esto sin definir: se usan los
# valores por defecto en settings.py.

DJANGO_SECRET_KEY=cambia-esto-por-una-clave-secreta-larga-y-aleatoria
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=tu-backend.onrender.com

# Datos del proveedor MySQL en la nube (ej. Aiven).
DB_NAME=farmacia_db
DB_USER=avnadmin
DB_PASSWORD=
DB_HOST=tu-host.aivencloud.com
DB_PORT=3306
DB_USE_SSL=True

# URL pública donde quedó el frontend (Vercel), separadas por comas si hay varias.
DJANGO_CORS_ALLOWED_ORIGINS=https://tu-frontend.vercel.app
DJANGO_CSRF_TRUSTED_ORIGINS=https://tu-frontend.vercel.app

# URL del microservicio blockchain (Render).
BLOCKCHAIN_SERVICE_URL=https://tu-blockchain-service.onrender.com
