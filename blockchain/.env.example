# Copia este archivo como ".env" y completa los valores (no lo subas a git).

# Local: http://127.0.0.1:7545 (Ganache)
# Nube: la URL pública del servicio "testnet-node" desplegado en Render
# (ver blockchain/testnet-node/), ej. https://farmacol-testnet-node.onrender.com
WEB3_PROVIDER_URL=http://127.0.0.1:7545

# Dirección del contrato. Es siempre la misma (nodo determinista, ver
# testnet-node/server.js) tanto en local como en la nube: no hace falta
# cambiarla.
CONTRACT_ADDRESS=0xe78A0F7E598Cc8b0Bb87894B0F60dD2a88d6a8Ab

# Solo si en el futuro usas una testnet pública real (Sepolia) en vez del
# nodo propio: clave privada de una wallet de prueba (ver deploy-sepolia.js).
# Con el nodo propio (testnet-node) se deja vacía.
PRIVATE_KEY=

# Puerto del microservicio (Render lo asigna automáticamente).
PORT=3000
