# Copia este archivo como ".env" y completa los valores (no lo subas a git).

# Local (Ganache): http://127.0.0.1:7545
# Nube (Sepolia vía Infura/Alchemy): https://sepolia.infura.io/v3/TU_API_KEY
WEB3_PROVIDER_URL=http://127.0.0.1:7545

# Dirección del contrato ya desplegado (ver deploy-sepolia.js).
CONTRACT_ADDRESS=0xe78A0F7E598Cc8b0Bb87894B0F60dD2a88d6a8Ab

# Solo necesaria en la nube (Sepolia): clave privada de la wallet que
# firma y paga el gas de las transacciones. En local (Ganache) se deja
# vacía y se usan las cuentas de prueba desbloqueadas.
PRIVATE_KEY=

# Puerto del microservicio (Render lo asigna automáticamente).
PORT=3000
